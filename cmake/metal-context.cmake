# Generate the context copy used by the default guard or short-MV experiment.
function(tokenomics_write_metal_context root output mode)
  file(READ "${root}/third_party/llama.cpp/src/llama-context.cpp" source)
  set(anchor "memory->init_batch(*balloc, cparams.n_ubatch, embd_all)")
  string(FIND "${source}" "${anchor}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned llama.cpp batch initialization changed")
  endif()
  if(mode STREQUAL "short-mv")
    file(READ "${root}/third_party/llama.cpp/src/llama-kv-cache.cpp" cache)
    string(FIND "${cache}" "const uint32_t n_pad = 256;" padding_position)
    if(padding_position EQUAL -1)
      message(FATAL_ERROR "Pinned KV padding changed; review Metal verification splitting")
    endif()
    set(source "#include \"${root}/src/metal_verification.h\"\n#include \"${root}/src/metal_verification_graph.h\"\n${source}")
    set(graph_anchor "        if (!ggml_backend_sched_alloc_graph(sched.get(), gf)) {")
    string(FIND "${source}" "${graph_anchor}" graph_position)
    if(graph_position EQUAL -1)
      message(FATAL_ERROR "Pinned context graph allocation changed")
    endif()
    set(graph_mark "        tokenomics::mark_metal_verification_graph(gf, tokenomics::metal_verification_graph(cparams.offload_kqv, cparams.causal_attn, cparams.n_seq_max == 1 && ubatch.n_seqs_unq == 1, ubatch.n_tokens, n_outputs));\n\n")
    string(REPLACE "${graph_anchor}" "${graph_mark}${graph_anchor}" source "${source}")
    set(replacement "memory->init_batch(*balloc, cparams.offload_kqv && cparams.causal_attn && n_tokens_all <= 9 && n_outputs_all == n_tokens_all ? tokenomics::metal_verification_ubatch(cparams.n_ubatch, cparams.n_seq_max == 1 ? int64_t(memory->seq_pos_max(0)) + 1 : 0, n_tokens_all, n_outputs_all, true, true, cparams.n_seq_max == 1) : cparams.n_ubatch, embd_all)")
  elseif(mode STREQUAL "single-row")
    set(replacement "memory->init_batch(*balloc, cparams.offload_kqv && cparams.causal_attn && n_tokens_all <= 9 && n_outputs_all == n_tokens_all ? 1 : cparams.n_ubatch, embd_all)")
  else()
    message(FATAL_ERROR "Unknown Metal context mode")
  endif()
  string(REPLACE "${anchor}" "${replacement}" source "${source}")
  file(WRITE "${output}" "${source}")
endfunction()
