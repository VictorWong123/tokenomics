# An opt-in scheduling experiment over unchanged upstream arithmetic.
function(tokenomics_metal_interleave root)
  if(NOT TOKENOMICS_METAL_SHORT_MV OR NOT GGML_METAL_EMBED_LIBRARY)
    message(FATAL_ERROR "Metal interleave requires short-MV and embedded Metal sources")
  endif()
  set(metal_dir "${root}/third_party/llama.cpp/ggml/src/ggml-metal")
  set(include "#include \"${root}/src/metal_interleave.h\"\n")

  file(READ "${metal_dir}/ggml-metal-device.cpp" device)
  set(anchor [=[    snprintf(base, 256, "kernel_mul_mv_%s_%s%s", ggml_type_name(tsrc0), ggml_type_name(tsrc1), suffix);]=])
  string(FIND "${device}" "${anchor}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Metal mat-vec pipeline naming changed")
  endif()
  string(REPLACE "${anchor}"
    "    if (tokenomics_metal_interleave(op)) { suffix = \"_interleaved\"; }\n${anchor}"
    device "${device}")
  set(device_path "${CMAKE_CURRENT_BINARY_DIR}/tokenomics-metal-device.cpp")
  file(WRITE "${device_path}" "${include}${device}")
  get_target_property(sources ggml-metal SOURCES)
  list(LENGTH sources before)
  list(FILTER sources EXCLUDE REGEX "(^|/)ggml-metal-device\\.cpp$")
  list(LENGTH sources after)
  math(EXPR expected "${before} - 1")
  if(NOT after EQUAL expected)
    message(FATAL_ERROR "Could not isolate pinned Metal device source")
  endif()
  set_property(TARGET ggml-metal PROPERTY SOURCES ${sources})
  target_sources(ggml-metal PRIVATE "${device_path}")

  set(ops_path "${CMAKE_CURRENT_BINARY_DIR}/tokenomics-metal-ops.cpp")
  file(READ "${ops_path}" ops)
  set(anchor [=[        ggml_metal_encoder_dispatch_threadgroups(enc, ((ne01 + nr0*nsg - 1)/(nr0*nsg)), ((ne11 + nr1 - 1)/nr1), ne12*ne13, 32, nsg, 1);]=])
  string(FIND "${ops}" "${anchor}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned quantized mat-vec grid changed")
  endif()
  # Build the replacement explicitly to retain the exact original fallback.
  set(replacement "        if (tokenomics_metal_interleave(op)) {\n            ggml_metal_encoder_dispatch_threadgroups(enc, ((ne11 + nr1 - 1)/nr1), ((ne01 + nr0*nsg - 1)/(nr0*nsg)), ne12*ne13, 32, nsg, 1);\n        } else {\n${anchor}\n        }")
  string(REPLACE "${anchor}" "${replacement}" ops "${ops}")
  file(WRITE "${ops_path}" "${include}${ops}")

  file(READ "${metal_dir}/kernels/mul_mv.metal" kernel)
  foreach(kind q4_K q6_K)
    set(start "[[host_name(\"kernel_mul_mv_${kind}_f32\")]]")
    string(FIND "${kernel}" "${start}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Pinned ${kind} kernel wrapper changed")
    endif()
    string(SUBSTRING "${kernel}" ${position} -1 tail)
    string(FIND "${tail}" "\n}" end)
    if(end EQUAL -1)
      message(FATAL_ERROR "Pinned ${kind} kernel wrapper has no end")
    endif()
    math(EXPR length "${end} + 2")
    string(SUBSTRING "${tail}" 0 ${length} wrapper)
    string(REPLACE "kernel_mul_mv_${kind}_f32\"" "kernel_mul_mv_${kind}_f32_interleaved\"" wrapper "${wrapper}")
    string(REPLACE "kernel void kernel_mul_mv_${kind}_f32(" "kernel void kernel_mul_mv_${kind}_f32_interleaved(" wrapper "${wrapper}")
    set(args_anchor "nullptr, tgpig, tiisg, sgitg);")
    string(FIND "${wrapper}" "${args_anchor}" args_position)
    if(args_position EQUAL -1)
      message(FATAL_ERROR "Pinned ${kind} wrapper arguments changed")
    endif()
    string(REPLACE "${args_anchor}" "nullptr, uint3(tgpig.y, tgpig.x, tgpig.z), tiisg, sgitg);" wrapper "${wrapper}")
    string(APPEND kernel "\n\n${wrapper}\n")
  endforeach()

  # Match upstream's embedded source expansion, replacing only mul_mv's ASM.
  file(READ "${metal_dir}/kernels/common.h" common)
  file(READ "${metal_dir}/kernels/dequantize.h" dequantize)
  file(READ "${metal_dir}/../ggml-common.h" ggml_common)
  file(READ "${metal_dir}/ggml-metal-impl.h" impl)
  set(embed "${common}\n${dequantize}\n${kernel}")
  foreach(line "#include \"common.h\"" "#include \"dequantize.h\"" "#pragma once")
    string(REPLACE "${line}" "" embed "${embed}")
  endforeach()
  string(REPLACE "__embed_ggml-common.h__" "${ggml_common}" embed "${embed}")
  string(REPLACE "#include \"ggml-metal-impl.h\"" "${impl}" embed "${embed}")
  set(embed_path "${CMAKE_CURRENT_BINARY_DIR}/tokenomics-metal-embed-mul_mv.metal")
  set(asm_path "${CMAKE_CURRENT_BINARY_DIR}/tokenomics-metal-embed-mul_mv.s")
  file(WRITE "${embed_path}" "${embed}")
  file(WRITE "${asm_path}" ".section __DATA,__ggml_metallib\n.globl _ggml_metallib_mul_mv_start\n_ggml_metallib_mul_mv_start:\n.incbin \"${embed_path}\"\n.globl _ggml_metallib_mul_mv_end\n_ggml_metallib_mul_mv_end:\n")
  get_target_property(sources ggml-metal SOURCES)
  list(LENGTH sources before)
  list(FILTER sources EXCLUDE REGEX "(^|/)ggml-metal-embed-mul_mv\\.s$")
  list(LENGTH sources after)
  math(EXPR expected "${before} - 1")
  if(NOT after EQUAL expected)
    message(FATAL_ERROR "Could not isolate embedded mat-vec ASM source")
  endif()
  set_property(TARGET ggml-metal PROPERTY SOURCES ${sources})
  target_sources(ggml-metal PRIVATE "${asm_path}")
endfunction()
