include("${CMAKE_CURRENT_LIST_DIR}/source-input.cmake")
# Group query rows using repeated calls to the unchanged pinned Q8_0 routine.
function(tokenomics_metal_q8_group root)
  if(NOT TOKENOMICS_METAL_SHORT_MV OR NOT GGML_METAL_EMBED_LIBRARY OR TOKENOMICS_METAL_INTERLEAVE)
    message(FATAL_ERROR "Q8 grouping requires short-MV, embedded shaders, and interleave OFF")
  endif()
  set(metal_dir "${root}/third_party/llama.cpp/ggml/src/ggml-metal")
  tokenomics_read_source("${metal_dir}/ggml-metal-device.cpp" device)
  set(anchor [=[    snprintf(base, 256, "kernel_mul_mv_%s_%s%s", ggml_type_name(tsrc0), ggml_type_name(tsrc1), suffix);]=])
  string(FIND "${device}" "${anchor}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Q8 pipeline naming changed")
  endif()
  set(select "    nr1 = tokenomics_metal_q8_group_rows(op);\n    if (nr1 > 1) { suffix = \"_grouped2\"; }\n")
  string(REPLACE "${anchor}" "${select}${anchor}" device "${device}")
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/tokenomics-metal-device.cpp")
  file(WRITE "${generated}" "#include \"${root}/src/metal_q8_group.h\"\n${device}")
  get_target_property(sources ggml-metal SOURCES)
  list(LENGTH sources before)
  list(FILTER sources EXCLUDE REGEX "(^|/)ggml-metal-device\\.cpp$")
  list(LENGTH sources after)
  math(EXPR expected "${before} - 1")
  if(NOT after EQUAL expected)
    message(FATAL_ERROR "Could not isolate pinned Metal device source")
  endif()
  set_property(TARGET ggml-metal PROPERTY SOURCES ${sources})
  target_sources(ggml-metal PRIVATE "${generated}")

  tokenomics_read_source("${metal_dir}/kernels/mul_mv.metal" kernel)
  string(FIND "${kernel}" "kernel_mul_mv_q8_0_f32_impl<N_R0_Q8_0, constant ggml_metal_kargs_mul_mv &>" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Q8 arithmetic entry point changed")
  endif()
  tokenomics_read_source("${root}/src/metal_q8_group_constants.h" constants)
  tokenomics_read_source("${root}/src/metal_q8_group.metal.inc" wrapper)
  string(APPEND kernel "\n${constants}\n${wrapper}\n")
  include("${root}/cmake/metal-embed.cmake")
  tokenomics_embed_metal_mul_mv("${root}" "${kernel}")
endfunction()
