function(tokenomics_study_repack)
  set(cpu_dir "${CMAKE_SOURCE_DIR}/third_party/llama.cpp/ggml/src/ggml-cpu")
  file(READ "${cpu_dir}/repack.cpp" source)
  set(old1 "if (nrows > 3) {")
  set(new1 "if (nrows > 9) {")
  set(old2 "for (int iter = nrows - (nrows % 4); iter < nrows; iter++) {")
  set(new2 "for (int iter = nrows > 9 ? nrows - (nrows % 4) : 0; iter < nrows; iter++) {")
  set(old3 "for (int64_t i11 = ith * 4; i11 < ne11 - ne11 % 4; i11 += nth * 4) {")
  set(new3 "for (int64_t i11 = ith * 4; i11 < (ne11 > 9 ? ne11 - ne11 % 4 : 0); i11 += nth * 4) {")
  set(old4 "const int64_t i11_processed = ne11 - ne11 % 4;")
  set(new4 "const int64_t i11_processed = ne11 > 9 ? ne11 - ne11 % 4 : 0;")
  foreach(index RANGE 1 4)
    string(FIND "${source}" "${old${index}}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Unexpected pinned repack selector ${index}")
    endif()
    string(REPLACE "${old${index}}" "${new${index}}" source "${source}")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/tokenomics-repack-study.cpp" "${source}")
  file(READ "${cpu_dir}/tiled/tiled.cpp" tiled)
  string(REPLACE "return rows >= 8 || ggml_tiled_matmul_forced();" "return rows > 9 && (rows >= 8 || ggml_tiled_matmul_forced());" tiled "${tiled}")
  file(WRITE "${CMAKE_BINARY_DIR}/tokenomics-tiled-study.cpp" "${tiled}")
  get_target_property(cpu_sources ggml-cpu SOURCES)
  list(LENGTH cpu_sources before)
  list(FILTER cpu_sources EXCLUDE REGEX "(^|/)ggml-cpu/repack\\.cpp$")
  list(FILTER cpu_sources EXCLUDE REGEX "(^|/)tiled/tiled\\.cpp$")
  list(LENGTH cpu_sources after)
  math(EXPR expected "${before} - 2")
  if(NOT after EQUAL expected)
    message(FATAL_ERROR "Could not isolate the pinned source pair")
  endif()
  set_property(TARGET ggml-cpu PROPERTY SOURCES ${cpu_sources})
  target_sources(ggml-cpu PRIVATE "${CMAKE_BINARY_DIR}/tokenomics-repack-study.cpp" "${CMAKE_BINARY_DIR}/tokenomics-tiled-study.cpp")
  target_include_directories(ggml-cpu PRIVATE "${cpu_dir}" "${cpu_dir}/tiled")
  add_executable(tokenomics_kernel_study "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tokenomics_kernel_study.cpp")
  target_link_libraries(tokenomics_kernel_study PRIVATE tokenomics_runtime)
endfunction()
cmake_language(DEFER CALL tokenomics_study_repack)
