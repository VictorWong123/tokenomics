function(tokenomics_study_tiled)
  add_executable(tokenomics_kernel_study "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tokenomics_kernel_study.cpp")
  target_link_libraries(tokenomics_kernel_study PRIVATE tokenomics_runtime)
  if(DEFINED TOKENOMICS_STUDY_FORCE_TILE AND NOT TOKENOMICS_STUDY_FORCE_TILE)
    return()
  endif()
  set(tiled_dir "${CMAKE_SOURCE_DIR}/third_party/llama.cpp/ggml/src/ggml-cpu/tiled")
  file(READ "${tiled_dir}/tiled.cpp" source)
  set(selector "return rows >= 8 || ggml_tiled_matmul_forced();")
  string(FIND "${source}" "${selector}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Unexpected pinned tiled selector")
  endif()
  string(REPLACE "${selector}" "return true;" source "${source}")
  file(WRITE "${CMAKE_BINARY_DIR}/tokenomics-tiled-study.cpp" "${source}")
  get_target_property(cpu_sources ggml-cpu SOURCES)
  list(FILTER cpu_sources EXCLUDE REGEX "(^|/)tiled/tiled\\.cpp$")
  set_property(TARGET ggml-cpu PROPERTY SOURCES ${cpu_sources})
  target_sources(ggml-cpu PRIVATE "${CMAKE_BINARY_DIR}/tokenomics-tiled-study.cpp")
  target_include_directories(ggml-cpu PRIVATE "${tiled_dir}")
endfunction()
cmake_language(DEFER CALL tokenomics_study_tiled)
