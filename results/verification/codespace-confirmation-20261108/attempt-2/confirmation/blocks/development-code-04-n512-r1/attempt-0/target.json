  "text": "Certainly! Below is an implementation of an LRU (Least Recently Used) cache in C++20. This cache will use a `std::unordered_map` for the keys and a `std::list` to maintain the order of the keys, ensuring that the most recently used items are at the front of the list. The `std::unordered_map` will provide O(1) get and put operations, and the `std::list` will maintain the order of the keys.\n\n```cpp\n#include <iostream>\n#include <unordered_map>\n#include <list>\n#include <string>\n#include <algorithm>\n\ntemplate <typename Key, typename Value>\nclass LRUCache {\npublic:\n    LRUCache(size_t capacity) : capacity_(capacity) {}\n\n    // Get the value for a key, moving the key to the front of the list if it's not already there.\n    Value& get(const Key& key) {\n        auto it = cache_.find(key);\n        if (it == cache_.end()) {\n            return Value(); // Return default-constructed value if key is not found.\n        }\n        move_to_front(it);\n        return it->second;\n    }\n\n    // Put a value for a key, moving the key to the front of the list if the cache is full.\n    void put(const Key& key, const Value& value) {\n        if (cache_.size() >= capacity_) {\n            // Remove the least recently used item (the one at the end of the list).\n            auto it = cache_.begin();\n            cache_.erase(it);\n        }\n        move_to_front(cache_.insert_or_assign(key, value));\n    }\n\nprivate:\n    size_t capacity_;\n    std::unordered_map<Key, Value> cache_;\n    std::list<Key> order_;\n\n    // Move the given key to the front of the list.\n    void move_to_front(std::list<Key>::iterator it) {\n        order_.splice(order_.begin(), order_, it);\n    }\n\n    // Insert or update the key-value pair in the cache and move it to the front of the list.\n    std::pair<std::list<Key>::iterator, bool> move_to_front(std::pair<std::list<Key>::iterator, Value>& pair) {\n        order_.splice(order_.begin(), order_, pair.first);\n        return {order_.begin(), true};\n    }\n};\n\nint main() {\n    LRUCache<int, std::string> cache(3);\n\n    cache.put(1, \"one\");\n    cache.put(",
