  "text": "Certainly! Below is a C++20 code snippet that parses a comma-separated list of signed integers, rejecting empty fields and trailing characters. The code includes explicit invariants, edge-case handling, a short usage example, and time/space complexity analysis. It also states any preconditions and avoids undefined behavior.\n\n### Code Implementation\n\n```cpp\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <stdexcept>\n\n// Function to parse a comma-separated list of signed integers\nstd::vector<int> parseCommaSeparatedIntegers(const std::string& input) {\n    std::vector<int> result;\n    std::istringstream iss(input);\n    std::string token;\n\n    // Skip leading whitespace\n    iss.ignore(std::numeric_limits<std::streamsize>::max(), ' ');\n\n    while (std::getline(iss, token, ',')) {\n        // Trim leading and trailing whitespace\n        size_t start = token.find_first_not_of(\" \\t\");\n        size_t end = token.find_last_not_of(\" \\t\");\n        if (start == std::string::npos || end == std::string::npos) {\n            continue; // Skip empty fields\n        }\n\n        std::string trimmedToken = token.substr(start, end - start + 1);\n        try {\n            int value = std::stoi(trimmedToken);\n            result.push_back(value);\n        } catch (const std::invalid_argument& e) {\n            // Handle invalid integer conversion\n            std::cerr << \"Invalid integer: \" << trimmedToken << std::endl;\n            continue;\n        } catch (const std::out_of_range& e) {\n            // Handle integer out of range\n            std::cerr << \"Integer out of range: \" << trimmedToken << std::endl;\n            continue;\n        }\n    }\n\n    return result;\n}\n\n// Function to check the correctness of the parseCommaSeparatedIntegers function\nvoid checkFunction() {\n    std::vector<int> result = parseCommaSeparatedIntegers(\"1, 2, 3, 4, 5\");\n    std::vector<int> expected = {1, 2, 3, 4, 5